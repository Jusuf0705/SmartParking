<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.SmartParking" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/blue_600</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/blue_50</item>
        <item name="colorOnPrimaryContainer">@color/blue_700</item>

        <item name="colorSecondary">@color/blue_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/blue_100</item>
        <item name="colorOnSecondaryContainer">@color/blue_700</item>

        <item name="colorTertiary">@color/amber_700</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorTertiaryContainer">@color/amber_100</item>
        <item name="colorOnTertiaryContainer">@color/amber_700</item>

        <item name="colorError">@color/destructive</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">@color/red_100</item>
        <item name="colorOnErrorContainer">@color/status_full_text</item>

        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/foreground</item>
        <item name="colorSurfaceVariant">@color/blue_50</item>
        <item name="colorOnSurfaceVariant">@color/muted_foreground</item>
        <item name="colorOutline">@color/border</item>
        <item name="colorOutlineVariant">@color/border_light</item>
        <item name="android:colorBackground">@color/background</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="Theme.SmartParking" parent="Base.Theme.SmartParking" />

</resources>