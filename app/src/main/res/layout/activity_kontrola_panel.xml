<?xml version="1.0" encoding="utf-8"?>
<!-- LOKACIJA: res/layout/activity_kontrola_panel.xml -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <!-- HERO HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_header_gradient">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="K"
                android:textColor="@color/blue_600"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_white_18_circle"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvControllerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kontrolor"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kontrolor · Tuzla, BiH"
                    android:textColor="@color/blue_200"
                    android:textSize="11sp"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExit"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text=""
                android:contentDescription="Odjavi se"
                android:background="@drawable/bg_white_18"
                app:backgroundTint="@null"
                app:icon="@android:drawable/ic_lock_power_off"
                app:iconSize="18dp"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:rippleColor="#33FFFFFF"
                app:elevation="0dp"
                tools:ignore="TouchTargetSizeCheck" />
        </LinearLayout>

        <!-- Stats strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_white_15_rounded"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:id="@+id/tvCheckedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Provjereno danas"
                    android:textColor="@color/blue_200"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_white_15_rounded"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:layout_marginStart="6dp">

                <TextView
                    android:id="@+id/tvFineCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kazni danas"
                    android:textColor="@color/blue_200"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- SCROLLABLE CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <!-- PRETRAGA kartica -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp"
                app:cardUseCompatPadding="true"
                app:cardPreventCornerOverlap="false"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Naslov sekcije sa plavom crticom (ETALON) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <View
                            android:layout_width="3dp"
                            android:layout_height="14dp"
                            android:background="@drawable/bg_section_bar_blue"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PRETRAGA PO TABLICAMA"
                            android:textSize="11sp"
                            android:letterSpacing="0.12"
                            android:textAllCaps="true"
                            android:textStyle="bold"
                            android:textColor="@color/foreground" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="10dp"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp"
                            app:boxStrokeColor="@color/blue_600"
                            app:boxStrokeWidth="2dp"
                            app:boxBackgroundColor="@color/blue_50"
                            app:hintEnabled="false"
                            app:endIconMode="clear_text"
                            app:endIconTint="@color/muted_foreground">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPlate"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:hint="npr. A12-K-345"
                                android:inputType="textCapCharacters"
                                android:imeOptions="actionSearch"
                                android:maxLines="1"
                                android:textAllCaps="true"
                                android:fontFamily="monospace"
                                android:textSize="15sp"
                                android:textColor="@color/foreground"
                                android:textColorHint="@color/muted_foreground"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:background="@null"
                                android:letterSpacing="0.06" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnSearch"
                            android:layout_width="wrap_content"
                            android:layout_height="52dp"
                            android:text="Traži"
                            android:textAllCaps="false"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:paddingStart="22dp"
                            android:paddingEnd="22dp"
                            android:background="@drawable/bg_btn_active_primary"
                            android:backgroundTint="@null"
                            android:stateListAnimator="@null"
                            tools:ignore="TouchTargetSizeCheck" />

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- REZULTAT kartica -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp"
                app:cardUseCompatPadding="true"
                app:cardPreventCornerOverlap="false"
                app:cardBackgroundColor="@color/white"
                app:strokeWidth="2dp"
                app:strokeColor="@color/green_500"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:id="@+id/tvStatusLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/foreground"
                            tools:text="Nije pronađeno" />

                        <TextView
                            android:id="@+id/tvStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:background="@drawable/bg_status_full"
                            tools:text="✕ ISTEKLO" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ZONA"
                        android:textSize="10sp"
                        android:letterSpacing="0.1"
                        android:textAllCaps="true"
                        android:textStyle="bold"
                        android:textColor="@color/muted_foreground"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvZoneValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/foreground"
                        android:layout_marginBottom="14dp"
                        tools:text="—" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REGISTARSKA OZNAKA"
                        android:textSize="10sp"
                        android:letterSpacing="0.1"
                        android:textAllCaps="true"
                        android:textStyle="bold"
                        android:textColor="@color/muted_foreground"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvPlateValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="@color/foreground"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="14dp"
                        tools:text="A12K345" />

                    <TextView
                        android:id="@+id/tvUntilLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VRIJEDI DO"
                        android:textSize="10sp"
                        android:letterSpacing="0.1"
                        android:textAllCaps="true"
                        android:textStyle="bold"
                        android:textColor="@color/muted_foreground"
                        android:layout_marginBottom="4dp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvUntilValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/foreground"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="4dp"
                        android:visibility="gone"
                        tools:text="27.03.2026  14:30"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvParkingValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/muted_foreground"
                        android:layout_marginBottom="4dp"
                        android:visibility="gone"
                        tools:text="Parking Skver"
                        tools:visibility="visible" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnIssueFine"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="12dp"
                        android:text="⚡ Izdaj kaznu"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_btn_delete_primary"
                        android:backgroundTint="@null"
                        android:stateListAnimator="@null"
                        android:visibility="gone"
                        tools:ignore="TouchTargetSizeCheck"
                        tools:visibility="visible" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>