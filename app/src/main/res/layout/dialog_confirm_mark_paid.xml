<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_bottom_sheet_handle"
        android:layout_marginBottom="20dp" />

    <!-- Ikonica ✓ (zeleni krug) -->
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_fine_avatar_green" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="✓"
            android:textColor="@color/green_700"
            android:textSize="28sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Naslov -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Označiti kao plaćeno?"
        android:textColor="@color/foreground"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Kazna će biti trajno zabilježena kao naplaćena"
        android:textColor="@color/muted_foreground"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- IZNOS - zeleni broj -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="18dp">

        <TextView
            android:id="@+id/tvConfirmPaidAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.00 KM"
            android:textColor="@color/green_700"
            android:textSize="34sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="0.9" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Iznos naplate"
            android:textColor="@color/muted_foreground"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- INFO redovi: Tablica / Parking -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_confirm_row"
        android:padding="14dp"
        android:layout_marginBottom="20dp">

        <!-- Registarska oznaka -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reg. oznaka"
                android:textColor="@color/muted_foreground"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvConfirmPaidPlate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/foreground"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.04" />
        </LinearLayout>

        <!-- Parking -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Parking"
                android:textColor="@color/muted_foreground"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvConfirmPaidParking"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="—"
                android:textColor="@color/foreground"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="end"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Da, označi kao plaćeno (zeleni CTA) -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnConfirmMarkPaid"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="✓ Da, označi kao plaćeno"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_active_primary"
        android:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:layout_marginBottom="10dp" />

    <!-- Odustani -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCancelMarkPaid"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Odustani"
        android:textAllCaps="false"
        android:textColor="@color/foreground"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_cancel"
        android:backgroundTint="@null"
        android:stateListAnimator="@null" />

</LinearLayout>