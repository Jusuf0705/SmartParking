<?xml version="1.0" encoding="utf-8"?>
<!--
    row_fine_admin.xml
    ID-ovi: rowTitle (plate), rowSubtitle (parking + reason), tvFineAmount, tvStatusBadge,
            vFineAvatarBg, tvFineAvatarIcon
    Klik na cijeli row otvara actions dialog.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="22dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <!-- Fine avatar (crveni ⚡ ili zeleni ✓) -->
        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginEnd="12dp">

            <View
                android:id="@+id/vFineAvatarBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_fine_avatar_red" />

            <TextView
                android:id="@+id/tvFineAvatarIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="⚡"
                android:textColor="@color/destructive"
                android:textSize="20sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Info: plate + parking/reason + iznos -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Plate (monospace, letter spacing) -->
            <TextView
                android:id="@+id/rowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/foreground"
                android:fontFamily="monospace"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="E70-T-218" />

            <!-- Parking + reason (subtitle) -->
            <TextView
                android:id="@+id/rowSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11sp"
                android:textColor="@color/muted_foreground"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Parking Centar · Nema karte" />

            <!-- Status pill + iznos -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.06"
                    android:textColor="@color/destructive"
                    android:background="@drawable/bg_status_pill_unpaid"
                    android:layout_marginEnd="8dp"
                    tools:text="NEPLAĆENO" />

                <TextView
                    android:id="@+id/tvFineAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/foreground"
                    tools:text="20.00 KM" />
            </LinearLayout>
        </LinearLayout>

        <!-- Strelica -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textSize="22sp"
            android:textColor="@color/muted_foreground"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>