<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:background="@drawable/bg_vehicle_card">

    <!-- Plavi krug sa ikonicom auta -->
    <FrameLayout
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_avatar_blue">

        <ImageView
            android:id="@+id/ivVehicleIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="Vozilo"
            android:src="@drawable/ic_car" />
    </FrameLayout>

    <!-- Nadimak prvo (bold), tablica ispod (monospace, muted) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvVehicleModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/foreground"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Golf 7" />

        <TextView
            android:id="@+id/tvVehiclePlate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/muted_foreground"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="A12-K-345" />
    </LinearLayout>

    <!-- Zelena "aktivno" tacka (opcioni indikator, sakrivena po defaultu) -->
    <View
        android:id="@+id/vActiveIndicator"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/bg_active_dot"
        android:layout_marginStart="8dp"
        android:visibility="gone" />

</LinearLayout>