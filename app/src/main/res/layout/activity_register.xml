<?xml version="1.0" encoding="utf-8"?>
<!-- activity_register.xml — šira form kartica, usklađen s loginom -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    tools:context=".ui.auth.RegisterActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:fillViewport="true"
        android:descendantFocusability="beforeDescendants"
        android:isScrollContainer="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HERO HEADER (centriran, bez back dugmeta) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_header_gradient"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="44dp"
                android:paddingBottom="44dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.02"
                    android:text="Kreiraj nalog"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Popunite podatke za registraciju"
                    android:textColor="@color/blue_100"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- FORM CARD — šira (manje margine, bez compat paddinga) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="-28dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="10dp"
                app:cardPreventCornerOverlap="false"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Registracija"
                        android:textColor="@color/foreground"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <!-- IME + PREZIME -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="IME"
                                android:textColor="@color/muted_foreground"
                                android:textSize="10sp"
                                android:textAllCaps="true"
                                android:letterSpacing="0.12"
                                android:textStyle="bold"
                                android:layout_marginBottom="6dp" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:boxCornerRadiusTopStart="14dp"
                                app:boxCornerRadiusTopEnd="14dp"
                                app:boxCornerRadiusBottomStart="14dp"
                                app:boxCornerRadiusBottomEnd="14dp"
                                app:boxStrokeColor="@color/blue_600"
                                app:boxStrokeWidth="2dp"
                                app:boxBackgroundColor="@color/blue_50"
                                app:hintEnabled="false"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etFirstName"
                                    android:layout_width="match_parent"
                                    android:layout_height="52dp"
                                    android:hint="Halid"
                                    android:textColorHint="@color/muted_foreground"
                                    android:textColor="@color/foreground"
                                    android:textSize="14sp"
                                    android:inputType="textPersonName|textCapWords"
                                    android:paddingStart="14dp"
                                    android:paddingEnd="10dp" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PREZIME"
                                android:textColor="@color/muted_foreground"
                                android:textSize="10sp"
                                android:textAllCaps="true"
                                android:letterSpacing="0.12"
                                android:textStyle="bold"
                                android:layout_marginBottom="6dp" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:boxCornerRadiusTopStart="14dp"
                                app:boxCornerRadiusTopEnd="14dp"
                                app:boxCornerRadiusBottomStart="14dp"
                                app:boxCornerRadiusBottomEnd="14dp"
                                app:boxStrokeColor="@color/blue_600"
                                app:boxStrokeWidth="2dp"
                                app:boxBackgroundColor="@color/blue_50"
                                app:hintEnabled="false"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etLastName"
                                    android:layout_width="match_parent"
                                    android:layout_height="52dp"
                                    android:hint="Kartal"
                                    android:textColorHint="@color/muted_foreground"
                                    android:textColor="@color/foreground"
                                    android:textSize="14sp"
                                    android:inputType="textPersonName|textCapWords"
                                    android:paddingStart="14dp"
                                    android:paddingEnd="10dp" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- EMAIL -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMAIL"
                        android:textColor="@color/muted_foreground"
                        android:textSize="10sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.12"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxStrokeColor="@color/blue_600"
                        app:boxStrokeWidth="2dp"
                        app:boxBackgroundColor="@color/blue_50"
                        app:hintEnabled="false"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:hint="vas@email.com"
                            android:textColorHint="@color/muted_foreground"
                            android:textColor="@color/foreground"
                            android:textSize="14sp"
                            android:inputType="textEmailAddress"
                            android:autofillHints="emailAddress"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- LOZINKA -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LOZINKA"
                        android:textColor="@color/muted_foreground"
                        android:textSize="10sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.12"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxStrokeColor="@color/blue_600"
                        app:boxStrokeWidth="2dp"
                        app:boxBackgroundColor="@color/blue_50"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/blue_600"
                        app:hintEnabled="false"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:hint="••••••••"
                            android:textColorHint="@color/muted_foreground"
                            android:textColor="@color/foreground"
                            android:textSize="14sp"
                            android:inputType="textPassword"
                            android:paddingStart="14dp"
                            android:paddingEnd="48dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- POTVRDI LOZINKU -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="POTVRDI LOZINKU"
                        android:textColor="@color/muted_foreground"
                        android:textSize="10sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.12"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxStrokeColor="@color/blue_600"
                        app:boxStrokeWidth="2dp"
                        app:boxBackgroundColor="@color/blue_50"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/blue_600"
                        app:hintEnabled="false"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:hint="••••••••"
                            android:textColorHint="@color/muted_foreground"
                            android:textColor="@color/foreground"
                            android:textSize="14sp"
                            android:inputType="textPassword"
                            android:paddingStart="14dp"
                            android:paddingEnd="48dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- KREIRAJ NALOG -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnRegister"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Kreiraj nalog"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:background="@drawable/bg_btn_active_primary"
                        android:backgroundTint="@null"
                        android:stateListAnimator="@null" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Prijava (dva reda, centrirano) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="14dp"
                android:paddingBottom="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Već imate nalog?"
                    android:textColor="@color/muted_foreground"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnGoToLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prijavi se"
                    android:textColor="@color/blue_600"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</FrameLayout>