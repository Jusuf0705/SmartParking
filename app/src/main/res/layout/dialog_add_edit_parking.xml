<?xml version="1.0" encoding="utf-8"?>
<!-- LOKACIJA: res/layout/dialog_add_edit_parking.xml — ETALON DIJALOGA -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Naslov + podnaslov (ETALON) -->
            <TextView
                android:id="@+id/tvParkingDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dodaj parking"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/foreground"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unesite podatke o parkingu"
                android:textColor="@color/muted_foreground"
                android:textSize="13sp"
                android:layout_marginBottom="20dp" />

            <!-- NAZIV -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NAZIV"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                android:textStyle="bold"
                android:textColor="@color/muted_foreground"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="@color/blue_600"
                app:boxStrokeWidth="2dp"
                app:boxBackgroundColor="@color/blue_50"
                app:hintEnabled="false"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="npr. Parking Centar"
                    android:textColorHint="@color/muted_foreground"
                    android:textColor="@color/foreground"
                    android:textSize="14sp"
                    android:inputType="textCapWords"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ADRESA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADRESA"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                android:textStyle="bold"
                android:textColor="@color/muted_foreground"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="@color/blue_600"
                app:boxStrokeWidth="2dp"
                app:boxBackgroundColor="@color/blue_50"
                app:hintEnabled="false"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAddress"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="npr. Franjevačka 2, Tuzla"
                    android:textColorHint="@color/muted_foreground"
                    android:textColor="@color/foreground"
                    android:textSize="14sp"
                    android:inputType="textCapWords"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ZONA dropdown -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ZONA"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                android:textStyle="bold"
                android:textColor="@color/muted_foreground"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="@color/blue_600"
                app:boxStrokeWidth="2dp"
                app:boxBackgroundColor="@color/blue_50"
                app:endIconTint="@color/blue_600"
                app:hintEnabled="false">

                <AutoCompleteTextView
                    android:id="@+id/etZoneDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@null"
                    android:completionThreshold="0"
                    android:hint="Odaberi zonu"
                    android:inputType="none"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="14sp"
                    android:textColor="@color/foreground"
                    android:textColorHint="@color/muted_foreground" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- UKUPAN BROJ MJESTA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UKUPAN BROJ MJESTA"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                android:textStyle="bold"
                android:textColor="@color/muted_foreground"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="@color/blue_600"
                app:boxStrokeWidth="2dp"
                app:boxBackgroundColor="@color/blue_50"
                app:hintEnabled="false"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTotalSpaces"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="npr. 20"
                    android:textColorHint="@color/muted_foreground"
                    android:textColor="@color/foreground"
                    android:textSize="14sp"
                    android:inputType="number"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_light"
                android:layout_marginBottom="18dp" />

            <!-- KOORDINATE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KOORDINATE"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                android:textStyle="bold"
                android:textColor="@color/muted_foreground"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxStrokeColor="@color/blue_600"
                    app:boxStrokeWidth="2dp"
                    app:boxBackgroundColor="@color/blue_50"
                    app:hintEnabled="false"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLat"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:hint="Lat"
                        android:textColorHint="@color/muted_foreground"
                        android:textColor="@color/foreground"
                        android:textSize="14sp"
                        android:inputType="numberDecimal|numberSigned"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxStrokeColor="@color/blue_600"
                    app:boxStrokeWidth="2dp"
                    app:boxBackgroundColor="@color/blue_50"
                    app:hintEnabled="false"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLng"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:hint="Lng"
                        android:textColorHint="@color/muted_foreground"
                        android:textColor="@color/foreground"
                        android:textSize="14sp"
                        android:inputType="numberDecimal|numberSigned"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnParkingSave"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Spasi"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_active_primary"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_marginBottom="10dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnParkingCancel"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Odustani"
                android:textAllCaps="false"
                android:textColor="@color/foreground"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_cancel"
                android:backgroundTint="@null"
                android:stateListAnimator="@null" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>