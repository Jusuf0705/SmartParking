<?xml version="1.0" encoding="utf-8"?>
<!-- LOKACIJA: res/layout/fragment_user_pay.xml -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- BALANCE HERO CARD -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/blue_600">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STANJE RAČUNA"
                    android:textColor="@color/blue_200"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.14"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <TextView
                        android:id="@+id/tvBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        android:lineSpacingMultiplier="0.9" />

                    <TextView
                        android:id="@+id/tvBalanceDecimal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=",00 KM"
                        android:textColor="@color/blue_200"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"
                        android:layout_marginStart="2dp" />
                </LinearLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOpenTopup"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="Dopuni"
                android:textAllCaps="false"
                android:textColor="@color/blue_600"
                android:textSize="13sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_credit_card"
                android:drawablePadding="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_hero_topup_btn"
                android:backgroundTint="@null"
                android:stateListAnimator="@null" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- AKTIVNE UPLATE (ViewPager2 swipe + dots) -->
    <LinearLayout
        android:id="@+id/llActiveSessions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp">

            <View
                android:layout_width="3dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_section_bar_green"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AKTIVNE UPLATE"
                android:textColor="@color/foreground"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.14"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvActiveCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/muted_foreground"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vpActiveSessions"
            android:layout_width="match_parent"
            android:layout_height="96dp" />

        <LinearLayout
            android:id="@+id/llSessionDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- VOZILO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="4dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp">

        <View
            android:layout_width="3dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_section_bar_blue"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VOZILO"
            android:textColor="@color/foreground"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.14"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpVehicles"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:id="@+id/llVehicleDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_marginBottom="14dp" />

    <!-- ZONA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="8dp">

        <View
            android:layout_width="3dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_section_bar_blue"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ZONA"
            android:textColor="@color/foreground"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.14"
            android:textStyle="bold" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:id="@+id/llZoneContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- TRAJANJE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="8dp">

        <View
            android:layout_width="3dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_section_bar_blue"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TRAJANJE"
            android:textColor="@color/foreground"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.14"
            android:textStyle="bold" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDuration1"
                android:layout_width="110dp"
                android:layout_height="68dp"
                android:text="1h"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_active_primary"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_marginEnd="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:lineSpacingExtra="1dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDuration2"
                android:layout_width="110dp"
                android:layout_height="68dp"
                android:text="2h"
                android:textAllCaps="false"
                android:textColor="@color/foreground"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_inactive_white"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_marginEnd="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:lineSpacingExtra="1dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDailyPass"
                android:layout_width="110dp"
                android:layout_height="68dp"
                android:text="24h"
                android:textAllCaps="false"
                android:textColor="@color/foreground"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_inactive_white"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:lineSpacingExtra="1dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnPay"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Plati"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_active_primary"
        android:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:drawablePadding="10dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="18dp" />

</LinearLayout>