<?xml version="1.0" encoding="utf-8"?>
<!-- Centriran dialog za welcome bonus - koristi rounded card umjesto bottom sheet -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="24dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="32dp"
        android:paddingBottom="24dp">

        <!-- Emoji krug -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_fine_avatar_green">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="🎉"
                android:textSize="40sp" />
        </FrameLayout>

        <!-- Naslov -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Dobrodošli!"
            android:textColor="@color/foreground"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Vaš račun je dopunjen sa"
            android:textColor="@color/muted_foreground"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- 10.00 KM veliki broj -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10.00"
                android:textColor="@color/green_700"
                android:textSize="48sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KM"
                android:textColor="@color/green_700"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="8dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Poklon dobrodošlice za nove korisnike"
            android:textColor="@color/muted_foreground"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Auto-dismiss indikator -->
        <ProgressBar
            android:id="@+id/pbWelcomeAutoDismiss"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:progress="100"
            android:progressDrawable="@drawable/progress_timer_green"
            android:layout_marginBottom="16dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnWelcomeClose"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Nastavi"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_active_primary"
            android:backgroundTint="@null"
            android:stateListAnimator="@null" />

    </LinearLayout>

</androidx.cardview.widget.CardView>