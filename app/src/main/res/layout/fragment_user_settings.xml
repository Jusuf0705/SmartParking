<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true">

    <!-- HEADER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="26dp"
        android:paddingBottom="13dp"
        android:paddingStart="24dp"
        android:paddingEnd="16dp">

        <!-- Naslov — centriran između ghost view-a -->
        <TextView
            android:id="@+id/tvSettingsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:text="Postavke"
            android:textColor="?attr/colorOnSurface"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/btnLogOut"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Logout dugme — desni ćošak, 34×34dp -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogOut"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text=""
            android:contentDescription="Odjavi se"
            app:icon="@android:drawable/ic_lock_power_off"
            app:iconSize="18dp"
            app:iconTint="?attr/colorError"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:cornerRadius="10dp"
            app:strokeColor="?attr/colorError"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- DIVIDER -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="?attr/colorOutlineVariant" />

    <!-- SADRŽAJ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- KARTICA: Opcije -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardUseCompatPadding="true"
            app:cardBackgroundColor="?attr/colorSurfaceVariant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Profil -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnProfile"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="8dp"
                    android:text="Profil"
                    android:textSize="15sp"
                    android:textColor="?attr/colorOnSurface"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    app:cornerRadius="14dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp"
                    app:icon="@android:drawable/ic_menu_my_calendar"
                    app:iconTint="?attr/colorPrimary"
                    app:iconSize="20dp"
                    app:iconPadding="12dp" />

                <!-- Vozila -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVehicles"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="8dp"
                    android:text="Upravljanje vozilima"
                    android:textSize="15sp"
                    android:textColor="?attr/colorOnSurface"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    app:cornerRadius="14dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp"
                    app:icon="@android:drawable/ic_menu_directions"
                    app:iconTint="?attr/colorPrimary"
                    app:iconSize="20dp"
                    app:iconPadding="12dp" />

                <!-- Dokupi kredit -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTopUp"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Dokupi kredit"
                    android:textSize="15sp"
                    android:textColor="?attr/colorOnSurface"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    app:cornerRadius="14dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp"
                    app:icon="@android:drawable/ic_menu_add"
                    app:iconTint="?attr/colorPrimary"
                    app:iconSize="20dp"
                    app:iconPadding="12dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</LinearLayout>