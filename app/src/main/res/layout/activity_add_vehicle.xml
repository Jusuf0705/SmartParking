<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_add_vehicle.xml — ETALON dizajna
    Standardi: header gradijent, kartica 22dp radius + cardUseCompatPadding,
    inputi 14dp radius, razmaci 8/14/20dp ritam, primary dugme 56dp.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <!-- HERO HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_header_gradient">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text=""
                android:contentDescription="Nazad"
                android:background="@drawable/bg_white_18"
                app:backgroundTint="@null"
                app:icon="@drawable/ic_chevron_left"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:rippleColor="#33FFFFFF"
                app:elevation="0dp"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Dodaj vozilo"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View android:layout_width="36dp" android:layout_height="36dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingBottom="28dp">

            <FrameLayout
                android:layout_width="76dp"
                android:layout_height="76dp">

                <ImageView
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:src="@drawable/ic_car"
                    android:tint="@color/white"
                    android:background="@drawable/bg_white_15_rounded"
                    android:padding="18dp"
                    android:contentDescription="Vozilo" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Novo vozilo"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unesite podatke ispod"
                android:textColor="@color/blue_200"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- SCROLLABLE FORM -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp"
                app:cardUseCompatPadding="true"
                app:cardPreventCornerOverlap="false"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Naslov sekcije sa plavom crticom (ETALON stil) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="18dp">

                        <View
                            android:layout_width="3dp"
                            android:layout_height="14dp"
                            android:background="@drawable/bg_section_bar_blue"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PODACI VOZILA"
                            android:textColor="@color/foreground"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:letterSpacing="0.12"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Marka -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MARKA"
                        android:textColor="@color/muted_foreground"
                        android:textSize="10sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxStrokeColor="@color/blue_600"
                        app:boxStrokeWidth="2dp"
                        app:boxBackgroundColor="@color/blue_50"
                        app:hintEnabled="false"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBrand"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:hint="npr. VW, Audi, BMW..."
                            android:textColorHint="@color/muted_foreground"
                            android:textColor="@color/foreground"
                            android:textSize="14sp"
                            android:inputType="textCapWords"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Tip vozila -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TIP VOZILA"
                        android:textColor="@color/muted_foreground"
                        android:textSize="10sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxStrokeColor="@color/blue_600"
                        app:boxStrokeWidth="2dp"
                        app:boxBackgroundColor="@color/blue_50"
                        app:hintEnabled="false"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etType"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:hint="npr. Auto, SUV, Motor..."
                            android:textColorHint="@color/muted_foreground"
                            android:textColor="@color/foreground"
                            android:textSize="14sp"
                            android:inputType="textCapWords"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Nadimak -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NADIMAK"
                        android:textColor="@color/muted_foreground"
                        android:textSize="10sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxStrokeColor="@color/blue_600"
                        app:boxStrokeWidth="2dp"
                        app:boxBackgroundColor="@color/blue_50"
                        app:hintEnabled="false"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNickname"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:hint="npr. Moj Golf"
                            android:textColorHint="@color/muted_foreground"
                            android:textColor="@color/foreground"
                            android:textSize="14sp"
                            android:inputType="text"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Registarska oznaka -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REGISTARSKA OZNAKA"
                        android:textColor="@color/muted_foreground"
                        android:textSize="10sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxStrokeColor="@color/blue_600"
                        app:boxStrokeWidth="2dp"
                        app:boxBackgroundColor="@color/blue_50"
                        app:hintEnabled="false"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPlate"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:hint="npr. A12-K-345"
                            android:textColorHint="@color/muted_foreground"
                            android:textColor="@color/foreground"
                            android:textSize="14sp"
                            android:inputType="textCapCharacters"
                            android:letterSpacing="0.05"
                            android:fontFamily="monospace"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveVehicle"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Sačuvaj vozilo"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_active_primary"
                app:backgroundTint="@null"
                app:cornerRadius="0dp"
                app:elevation="0dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>