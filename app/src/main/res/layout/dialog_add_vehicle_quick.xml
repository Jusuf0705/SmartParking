<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_avatar_blue">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_car"
                app:tint="@color/white"
                android:contentDescription="Vozilo" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Dodaj vozilo"
            android:textColor="@color/foreground"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Sačuvajte vozilo u vaš profil"
            android:textColor="@color/muted_foreground"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REGISTARSKE OZNAKE"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:letterSpacing="0.12"
            android:textStyle="bold"
            android:textColor="@color/muted_foreground"
            android:layout_marginBottom="6dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxStrokeColor="@color/blue_600"
            app:boxStrokeWidth="2dp"
            app:boxBackgroundColor="@color/blue_50"
            app:hintEnabled="false"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etQuickPlate"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="npr. A12-K-345"
                android:textColorHint="@color/muted_foreground"
                android:textColor="@color/foreground"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.05"
                android:inputType="textCapCharacters"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NADIMAK (OPCIONO)"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:letterSpacing="0.12"
            android:textStyle="bold"
            android:textColor="@color/muted_foreground"
            android:layout_marginBottom="6dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxStrokeColor="@color/blue_600"
            app:boxStrokeWidth="2dp"
            app:boxBackgroundColor="@color/blue_50"
            app:hintEnabled="false"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etQuickNickname"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="npr. Golf 7, Servisno vozilo..."
                android:textColorHint="@color/muted_foreground"
                android:textColor="@color/foreground"
                android:textSize="14sp"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnQuickSave"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Sačuvaj vozilo"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_active_primary"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:layout_marginBottom="10dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnQuickCancel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Odustani"
            android:textAllCaps="false"
            android:textColor="@color/foreground"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_cancel"
            android:backgroundTint="@null"
            android:stateListAnimator="@null" />

    </LinearLayout>
</LinearLayout>