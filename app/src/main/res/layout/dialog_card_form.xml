<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_bottom_sheet_handle"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvFormTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Podaci kartice"
            android:textColor="@color/foreground"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Unesite podatke o kartici"
            android:textColor="@color/muted_foreground"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <!-- Broj kartice -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BROJ KARTICE"
            android:textColor="@color/muted_foreground"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:letterSpacing="0.12"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginBottom="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_credit_card"
                android:tint="@color/muted_foreground"
                android:layout_marginEnd="10dp"
                android:contentDescription="Kartica" />

            <EditText
                android:id="@+id/etCardNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="1111 1111 1111 1111"
                android:textColorHint="@color/muted_foreground"
                android:textColor="@color/foreground"
                android:textSize="15sp"
                android:inputType="number"
                android:maxLength="19"
                android:background="@null"
                android:padding="0dp"
                android:letterSpacing="0.1"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Ime vlasnika -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IME VLASNIKA"
            android:textColor="@color/muted_foreground"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:letterSpacing="0.12"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etCardHolder"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:hint="IME PREZIME"
            android:textColorHint="@color/muted_foreground"
            android:textColor="@color/foreground"
            android:textSize="14sp"
            android:textStyle="bold"
            android:inputType="textCapCharacters|textPersonName"
            android:layout_marginBottom="14dp" />

        <!-- MM/GG + CVC -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DATUM ISTEKA"
                    android:textColor="@color/muted_foreground"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.12"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etCardExpiry"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_card_input"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:hint="MM/GG"
                    android:textColorHint="@color/muted_foreground"
                    android:textColor="@color/foreground"
                    android:textSize="14sp"
                    android:inputType="number"
                    android:maxLength="5"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CVC"
                    android:textColor="@color/muted_foreground"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.12"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etCardCvc"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_card_input"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:hint="•••"
                    android:textColorHint="@color/muted_foreground"
                    android:textColor="@color/foreground"
                    android:textSize="14sp"
                    android:inputType="numberPassword"
                    android:maxLength="4"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveCard"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Sačuvaj karticu"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_active_primary"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:layout_marginBottom="10dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelForm"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Odustani"
            android:textAllCaps="false"
            android:textColor="@color/foreground"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_cancel"
            android:backgroundTint="@null"
            android:stateListAnimator="@null" />

    </LinearLayout>
</ScrollView>