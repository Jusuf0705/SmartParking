<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvZoneDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dodaj zonu"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/foreground"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Postavite naziv i cijene zone"
                android:textColor="@color/muted_foreground"
                android:textSize="13sp"
                android:layout_marginBottom="20dp" />

            <!-- NAZIV ZONE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NAZIV ZONE"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                android:textStyle="bold"
                android:textColor="@color/muted_foreground"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="@color/blue_600"
                app:boxStrokeWidth="2dp"
                app:boxBackgroundColor="@color/blue_50"
                app:hintEnabled="false"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etZoneName"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="npr. Zona 1"
                    android:textColorHint="@color/muted_foreground"
                    android:textColor="@color/foreground"
                    android:textSize="14sp"
                    android:inputType="textCapWords"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_light"
                android:layout_marginBottom="18dp" />

            <!-- CIJENE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CIJENE"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                android:textStyle="bold"
                android:textColor="@color/muted_foreground"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CIJENA 1H"
                        android:textSize="10sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"
                        android:textStyle="bold"
                        android:textColor="@color/muted_foreground"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxStrokeColor="@color/blue_600"
                        app:boxStrokeWidth="2dp"
                        app:boxBackgroundColor="@color/blue_50"
                        app:hintEnabled="false"
                        app:suffixText="KM"
                        app:suffixTextColor="@color/muted_foreground"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPerHour"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:hint="0.00"
                            android:textColorHint="@color/muted_foreground"
                            android:textColor="@color/foreground"
                            android:textSize="14sp"
                            android:inputType="numberDecimal"
                            android:paddingStart="16dp"
                            android:paddingEnd="8dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DNEVNA KARTA"
                        android:textSize="10sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"
                        android:textStyle="bold"
                        android:textColor="@color/muted_foreground"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxStrokeColor="@color/blue_600"
                        app:boxStrokeWidth="2dp"
                        app:boxBackgroundColor="@color/blue_50"
                        app:hintEnabled="false"
                        app:suffixText="KM"
                        app:suffixTextColor="@color/muted_foreground"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPerDay"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:hint="0.00"
                            android:textColorHint="@color/muted_foreground"
                            android:textColor="@color/foreground"
                            android:textSize="14sp"
                            android:inputType="numberDecimal"
                            android:paddingStart="16dp"
                            android:paddingEnd="8dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnZoneSave"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Spasi"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_active_primary"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_marginBottom="10dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnZoneCancel"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Odustani"
                android:textAllCaps="false"
                android:textColor="@color/foreground"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_cancel"
                android:backgroundTint="@null"
                android:stateListAnimator="@null" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>