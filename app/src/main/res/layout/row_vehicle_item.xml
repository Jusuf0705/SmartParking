<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="22dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TOP: ikona + tekst + osnovno bedž -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Auto ikonica u obojenom kvadratu (boja se postavlja iz koda) -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp">

                <View
                    android:id="@+id/vIconBg"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_vehicle_icon_tinted" />

                <ImageView
                    android:id="@+id/ivVehicleColor"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_car"
                    android:contentDescription="Vozilo" />
            </FrameLayout>

            <!-- Naslov + marka + tablica -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvVehicleNickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/foreground"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVehicleBrand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/muted_foreground"
                    android:textSize="12sp"
                    android:layout_marginTop="1dp" />

                <!-- Tablica kao pill -->
                <TextView
                    android:id="@+id/tvVehiclePlate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/blue_600"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:background="@drawable/bg_zone_badge_pill"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- OSNOVNO bedž -->
            <TextView
                android:id="@+id/tvDefaultBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OSNOVNO"
                android:textColor="@color/status_available_text"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:background="@drawable/bg_default_badge"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/brand_blue_border_faint"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp" />

        <!-- BOTTOM: dugmad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEditVehicle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Izmijeni"
                android:textAllCaps="false"
                android:textColor="@color/blue_600"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_edit_vehicle"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_marginEnd="8dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDeleteVehicle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Obriši"
                android:textAllCaps="false"
                android:textColor="@color/destructive"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_delete_vehicle"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>