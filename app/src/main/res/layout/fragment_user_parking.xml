<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_header_gradient"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp">

        <!-- Title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Smart Parking"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_location"
                        app:tint="@color/blue_200"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tuzla, BiH"
                        android:textColor="@color/blue_200"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- btnFilter uklonjen — filteri su sada dostupni u chip scroll redu ispod -->
        </LinearLayout>

        <!-- Stats pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_white_15_rounded"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Slobodna mjesta"
                    android:textColor="@color/blue_100"
                    android:textSize="12sp"
                    android:layout_marginBottom="2dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvTotalFree"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTotalSpots"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/ 0"
                        android:textColor="@color/blue_200"
                        android:textSize="14sp"
                        android:layout_marginStart="6dp" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_car"
                app:tint="@color/white"
                android:background="@drawable/bg_white_18_circle"
                android:padding="14dp"
                android:contentDescription="Parking" />
        </LinearLayout>

        <!--
            Horizontalni scroll sa svim filterima.
            HorizontalScrollView omogućava skorlanje lijevo/desno.
            fillViewport=true da red popuni širinu kad ima malo filtera.
        -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:clipToPadding="false"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Zadržavam ID btnZoneAll za kompatibilnost sa postojećim Java kodom -->
                <TextView
                    android:id="@+id/btnZoneAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sve"
                    android:textColor="@color/blue_600"
                    android:background="@drawable/bg_filter_chip_active"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnFilterFree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Slobodno"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_filter_chip_inactive"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnFilterFull"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zauzeto"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_filter_chip_inactive"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Zadržan ID btnZone1 za kompatibilnost -->
                <TextView
                    android:id="@+id/btnZone1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zona 1"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_filter_chip_inactive"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Zadržan ID btnZone2 za kompatibilnost -->
                <TextView
                    android:id="@+id/btnZone2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zona 2"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_filter_chip_inactive"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnZone3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zona 3"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_filter_chip_inactive"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnFilterDistAsc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Najbliža"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_filter_chip_inactive"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnFilterDistDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Najdalja"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_filter_chip_inactive"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnFilterPriceAsc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Najjeftinije"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_filter_chip_inactive"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnFilterPriceDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Najskuplje"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_filter_chip_inactive"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- PARKING LIST -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvParkingList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbars="none" />

    <!--
        BottomNavigationView UKLONJEN.
        Host Activity mora imati vlastiti BottomNavigationView sa
        app:menu="@menu/bottom_nav_menu" da bi navigacija radila.
    -->

</LinearLayout>